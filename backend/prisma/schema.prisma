generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CONTADOR
  AUXILIAR
}

enum RolEmpresa {
  ADMIN
  CONTADOR
  AUXILIAR
}

enum EstadoProceso {
  SIN_INICIAR
  EN_PROCESO
  PENDIENTE
  AL_DIA
  CERRADO
}

enum TipoActividadProceso {
  COMPROBANTES
  CONCILIACION
  NOMINA
  PROVISION_CARTERA
  PRESUPUESTO
  CIERRE_PERIODO
  CIERRE_ANIO
}

enum Naturaleza {
  DEUDORA
  ACREEDORA
}

enum TipoTercero {
  CLIENTE
  PROVEEDOR
  AMBOS
}

enum TipoDocumento {
  CC
  NIT
  CE
  PASAPORTE
}

enum TipoDocumentoCliente {
  NIT
  CC
  CE
  PASAPORTE
}

enum TipoComprobante {
  DIARIO
  INGRESO
  EGRESO
}

enum EstadoComprobante {
  BORRADOR
  CONTABILIZADO
  ANULADO
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

enum EstadoNomina {
  BORRADOR
  CONTABILIZADO
  ANULADO
}

enum TipoAlerta {
  CARTERA_VENCE
  PERIODO_SIN_CERRAR
  ACTIVO_SIN_BAJA
  TERCERO_SIN_MOVIMIENTO
  RESPALDO_DESACTUALIZADO
}

enum EstadoCartera {
  PENDIENTE
  ABONADA
  CANCELADA
  VENCIDA
}

enum FormaPago {
  EFECTIVO
  CHEQUE
  TRANSFERENCIA
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum MetodoDepreciacion {
  LINEA_RECTA
}

enum EstadoActivoFijo {
  ACTIVO
  DEPRECIADO_TOTAL
  DADO_DE_BAJA
}

enum EstadoConciliacion {
  EN_PROCESO
  APROBADA
  ANULADA
}

enum TipoAdjuntoEntidad {
  COMPROBANTE
  EMPRESA
}

enum AccionAuditoria {
  CONTABILIZAR
  ANULAR
  ELIMINAR_COMPROBANTE
  CERRAR_PERIODO
  REABRIR_PERIODO
  CREAR_USUARIO
  CREAR_CUENTA
  EDITAR_CUENTA
  CREAR_ACTIVO
  EDITAR_ACTIVO
  DEPRECIAR_ACTIVOS
  BAJA_ACTIVO
  CERRAR_ANIO
  CALCULAR_PROVISION
  CREAR_EMPLEADO
  EDITAR_EMPLEADO
  RETIRAR_EMPLEADO
  LIQUIDAR_NOMINA
  CONTABILIZAR_NOMINA
  ANULAR_NOMINA
  PROVISIONAR_NOMINA
  ACTUALIZAR_PARAMETROS_NOMINA
  CARGAR_PRESUPUESTO
  SUBIR_ADJUNTO
  ELIMINAR_ADJUNTO
  IMPORTAR_EXTRACTO
  APROBAR_CONCILIACION
  ANULAR_CONCILIACION
  CREAR_EMPRESA
  EDITAR_EMPRESA
  DESACTIVAR_EMPRESA
  ACTIVAR_EMPRESA
  ASIGNAR_USUARIO_EMPRESA
  CAMBIAR_ROL_EMPRESA
  RETIRAR_USUARIO_EMPRESA
  CREAR_PROCESO
  ACTUALIZAR_PROCESO
  ELIMINAR_PROCESO
  MARCAR_ACTIVIDAD
  AGREGAR_NOTA
}

model Empresa {
  id               String   @id @default(uuid())
  nombre           String
  nit              String
  tipoDocumento    TipoDocumentoCliente @default(NIT)
  direccion        String?
  telefono         String?
  moneda           String   @default("COP")
  anioFiscalInicio Int      @default(1)
  mensajeRecibo    String?
  activa           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usuariosEmpresa        UsuarioEmpresa[]
  cuentas                Cuenta[]
  terceros               Tercero[]
  periodos               Periodo[]
  comprobantes           Comprobante[]
  consecutivos           Consecutivo[]
  cuentasPorCobrar       CuentaPorCobrar[]
  cuentasPorPagar        CuentaPorPagar[]
  productos              Producto[]
  activosFijos           ActivoFijo[]
  auditorias             Auditoria[]
  cierresAnuales         CierreAnual[]
  parametrosProvision    ParametroProvision[]
  parametrosNomina       ParametroNomina[]
  parametrosCuentaNomina ParametroCuentaNomina[]
  procesosContables      ProcesoContable[]
  adjuntos               Adjunto[]
  conciliaciones         Conciliacion[]

  @@index([activa])
}

model UsuarioEmpresa {
  id        String     @id @default(uuid())
  usuarioId String
  empresaId String
  rol       RolEmpresa
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
}

model Usuario {
  id                   String        @id @default(uuid())
  nombre               String
  email                String        @unique
  passwordHash         String
  rol                  Rol           @default(AUXILIAR)
  activo               Boolean       @default(true)
  debeCambiarPassword  Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  comprobantesCreados  Comprobante[] @relation("Creador")
  comprobantesAnulados Comprobante[] @relation("Anulador")
  auditorias           Auditoria[]
  cierresAnuales       CierreAnual[]
  usuarioEmpresas      UsuarioEmpresa[]
  notasSeguimiento     NotaSeguimiento[]
  adjuntos             Adjunto[]
  conciliaciones       Conciliacion[] @relation("ConciliacionAprobador")
}

model ProcesoContable {
  id        String        @id @default(uuid())
  empresaId String
  anio      Int
  estado    EstadoProceso @default(SIN_INICIAR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  actividades ActividadProceso[]
  notas       NotaSeguimiento[]

  @@unique([empresaId, anio])
  @@index([empresaId])
}

model ActividadProceso {
  id            Int                   @id @default(autoincrement())
  procesoId     String
  tipo          TipoActividadProceso
  orden         Int
  estado        Boolean               @default(false)
  fechaEsperada DateTime?             @db.Date
  fechaReal     DateTime?             @db.Date
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  proceso ProcesoContable @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([procesoId])
}

model NotaSeguimiento {
  id        String   @id @default(uuid())
  procesoId String
  usuarioId String
  texto     String
  createdAt DateTime @default(now())

  proceso ProcesoContable @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  usuario Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([procesoId])
}

model Cuenta {
  id                Int        @id @default(autoincrement())
  empresaId         String?
  codigo            String
  nombre            String
  nivel             Int
  clase             Int
  grupo             Int?
  cuenta            Int?
  subcuenta         Int?
  naturaleza        Naturaleza
  permiteMovimiento Boolean    @default(false)
  afectaResultado   Boolean    @default(false)
  requiereTercero   Boolean    @default(false)
  activa            Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  empresa Empresa? @relation(fields: [empresaId], references: [id])

  asientos Asiento[]

  activosActivo        ActivoFijo[] @relation("ActivoCuenta")
  activosDepreciacion  ActivoFijo[] @relation("ActivoCuentaDepreciacion")
  activosGasto         ActivoFijo[] @relation("ActivoCuentaGasto")
  cierresAnuales       CierreAnual[] @relation("CierreCuentaUtilidad")
  parametrosCuentaNomina ParametroCuentaNomina[]
  presupuestos         Presupuesto[]
  conciliaciones       Conciliacion[]

  @@unique([empresaId, codigo])
  @@index([clase, grupo])
  @@index([nivel])
}

model Tercero {
  id                String        @id @default(uuid())
  empresaId         String
  tipo              TipoTercero   @default(CLIENTE)
  tipoDocumento     TipoDocumento
  documento         String
  nombreRazonSocial String
  direccion         String?
  telefono          String?
  email             String?
  ciudad            String?
  activo            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  comprobantes Comprobante[]
  asientos     Asiento[]
  cuentasPorCobrar CuentaPorCobrar[]
  cuentasPorPagar  CuentaPorPagar[]
  recibos          Recibo[]
  pagos            Pago[]
  empleado         Empleado?

  @@unique([empresaId, tipoDocumento, documento])
  @@index([empresaId, tipo])
}

model Periodo {
  id          Int           @id @default(autoincrement())
  empresaId   String
  nombre      String
  fechaInicio DateTime      @db.Date
  fechaFin    DateTime      @db.Date
  estado      EstadoPeriodo @default(ABIERTO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  comprobantes Comprobante[]

  depreciaciones Depreciacion[]
  provisionesCartera ProvisionCartera[]
  nominas          Nomina[]
  provisionesNomina ProvisionNomina[]
  presupuestos     Presupuesto[]
  conciliaciones   Conciliacion[]

  @@unique([empresaId, nombre])
  @@index([estado])
}

model Comprobante {
  id             Int                @id @default(autoincrement())
  empresaId      String
  tipo           TipoComprobante
  consecutivo    Int
  fecha          DateTime           @db.Date
  periodoId      Int
  terceroId      String?
  concepto       String
  totalDebito    Decimal            @default(0) @db.Decimal(15, 2)
  totalCredito   Decimal            @default(0) @db.Decimal(15, 2)
  estado         EstadoComprobante  @default(BORRADOR)
  usuarioCreoId  String
  usuarioAnuloId String?
  fechaAnulacion DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  empresa        Empresa     @relation(fields: [empresaId], references: [id])
  periodo        Periodo     @relation(fields: [periodoId], references: [id])
  tercero        Tercero?    @relation(fields: [terceroId], references: [id])
  usuarioCreo    Usuario     @relation("Creador", fields: [usuarioCreoId], references: [id])
  usuarioAnulo   Usuario?    @relation("Anulador", fields: [usuarioAnuloId], references: [id])
  asientos       Asiento[]
  cuentasPorCobrar CuentaPorCobrar[]
  cuentasPorPagar  CuentaPorPagar[]
  recibos          Recibo[]
  pagos            Pago[]
  inventarioMovimientos InventarioMovimiento[]
  depreciaciones   Depreciacion[]
  cierreAnual      CierreAnual?
  provisionesCartera ProvisionCartera[]
  nominas          Nomina[]
  provisionesNomina ProvisionNomina[]

  @@unique([empresaId, tipo, consecutivo])
  @@index([empresaId, periodoId])
  @@index([empresaId, fecha])
  @@index([estado])
}

model Asiento {
  id            Int     @id @default(autoincrement())
  comprobanteId Int
  cuentaId      Int
  terceroId     String?
  debito        Decimal @default(0) @db.Decimal(15, 2)
  credito       Decimal @default(0) @db.Decimal(15, 2)
  detalle       String?

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuenta      Cuenta      @relation(fields: [cuentaId], references: [id])
  tercero     Tercero?    @relation(fields: [terceroId], references: [id])

  movimientosExtracto MovimientoExtracto[]

  @@index([comprobanteId])
  @@index([cuentaId])
}

model Consecutivo {
  empresaId String
  tipo      TipoComprobante
  ultimo    Int             @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([empresaId, tipo])
}

model CuentaPorCobrar {
  id               Int          @id @default(autoincrement())
  empresaId        String
  terceroId        String
  comprobanteId    Int?
  numeroDocumento  String
  fechaEmision     DateTime     @db.Date
  fechaVencimiento DateTime     @db.Date
  valor            Decimal      @db.Decimal(15, 2)
  saldo            Decimal      @db.Decimal(15, 2)
  estado           EstadoCartera @default(PENDIENTE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  tercero     Tercero     @relation(fields: [terceroId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])
  recibos     Recibo[]

  @@index([empresaId, terceroId])
  @@index([empresaId, estado])
}

model CuentaPorPagar {
  id               Int          @id @default(autoincrement())
  empresaId        String
  terceroId        String
  comprobanteId    Int?
  numeroDocumento  String
  fechaEmision     DateTime     @db.Date
  fechaVencimiento DateTime     @db.Date
  valor            Decimal      @db.Decimal(15, 2)
  saldo            Decimal      @db.Decimal(15, 2)
  estado           EstadoCartera @default(PENDIENTE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  tercero     Tercero     @relation(fields: [terceroId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])
  pagos       Pago[]

  @@index([empresaId, terceroId])
  @@index([empresaId, estado])
}

model Recibo {
  id            Int        @id @default(autoincrement())
  numero        String
  fecha         DateTime   @db.Date
  terceroId     String
  cxcId         Int?
  comprobanteId Int?
  valor         Decimal    @db.Decimal(15, 2)
  formaPago     FormaPago  @default(EFECTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tercero    Tercero         @relation(fields: [terceroId], references: [id])
  cxc        CuentaPorCobrar? @relation(fields: [cxcId], references: [id])
  comprobante Comprobante?   @relation(fields: [comprobanteId], references: [id])
}

model Pago {
  id            Int        @id @default(autoincrement())
  numero        String
  fecha         DateTime   @db.Date
  terceroId     String
  cxpId         Int?
  comprobanteId Int?
  valor         Decimal    @db.Decimal(15, 2)
  formaPago     FormaPago  @default(EFECTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tercero    Tercero         @relation(fields: [terceroId], references: [id])
  cxp        CuentaPorPagar? @relation(fields: [cxpId], references: [id])
  comprobante Comprobante?   @relation(fields: [comprobanteId], references: [id])
}

model Producto {
  id             Int     @id @default(autoincrement())
  empresaId      String
  codigo         String
  nombre         String
  categoria      String?
  unidad         String  @default("und")
  costoPromedio  Decimal @default(0) @db.Decimal(15, 2)
  cantidadActual Decimal @default(0) @db.Decimal(15, 2)
  activo         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  movimientos InventarioMovimiento[]

  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
}

model InventarioMovimiento {
  id            Int                        @id @default(autoincrement())
  productoId    Int
  comprobanteId Int?
  tipo          TipoMovimientoInventario
  cantidad      Decimal                    @db.Decimal(15, 2)
  costoUnitario Decimal                    @db.Decimal(15, 2)
  fecha         DateTime                   @db.Date
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  producto    Producto    @relation(fields: [productoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@index([productoId])
}

model ActivoFijo {
  id                    Int                @id @default(autoincrement())
  empresaId             String
  cuentaId              Int
  cuentaDepreciacionId  Int
  cuentaGastoId         Int
  nombre                String
  fechaAdquisicion      DateTime           @db.Date
  valor                 Decimal            @db.Decimal(15, 2)
  vidaUtilMeses         Int
  valorResidual         Decimal            @default(0) @db.Decimal(15, 2)
  metodo                MetodoDepreciacion @default(LINEA_RECTA)
  depreciacionAcumulada Decimal            @default(0) @db.Decimal(15, 2)
  estado                EstadoActivoFijo   @default(ACTIVO)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  empresa          Empresa         @relation(fields: [empresaId], references: [id])
  cuenta           Cuenta          @relation("ActivoCuenta", fields: [cuentaId], references: [id])
  cuentaDepreciacion Cuenta        @relation("ActivoCuentaDepreciacion", fields: [cuentaDepreciacionId], references: [id])
  cuentaGasto      Cuenta          @relation("ActivoCuentaGasto", fields: [cuentaGastoId], references: [id])
  depreciaciones   Depreciacion[]

  @@index([empresaId, estado])
}

model Depreciacion {
  id            Int      @id @default(autoincrement())
  activoId      Int
  periodoId     Int
  comprobanteId Int?
  valor         Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  activo      ActivoFijo   @relation(fields: [activoId], references: [id])
  periodo     Periodo      @relation(fields: [periodoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@unique([activoId, periodoId])
  @@index([periodoId])
}

model Auditoria {
  id         Int             @id @default(autoincrement())
  empresaId  String?
  usuarioId  String
  accion     AccionAuditoria
  entidad    String
  entidadId  String
  detalle    Json?
  fecha      DateTime        @default(now())

  empresa Empresa? @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, entidad, entidadId])
  @@index([fecha])
  @@index([usuarioId])
}

model CierreAnual {
  id               Int      @id @default(autoincrement())
  empresaId        String
  anio             Int
  comprobanteId    Int      @unique
  cuentaUtilidadId Int
  usuarioId        String
  fecha            DateTime @default(now())

  empresa        Empresa     @relation(fields: [empresaId], references: [id])
  comprobante    Comprobante @relation(fields: [comprobanteId], references: [id])
  cuentaUtilidad Cuenta      @relation("CierreCuentaUtilidad", fields: [cuentaUtilidadId], references: [id])
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, anio])
}

model ParametroProvision {
  id         Int      @id @default(autoincrement())
  empresaId  String?
  diasDesde  Int
  diasHasta  Int?
  porcentaje Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  empresa Empresa? @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, diasDesde, diasHasta])
}

model ProvisionCartera {
  id             Int      @id @default(autoincrement())
  periodoId      Int
  comprobanteId  Int?
  totalCalculado Decimal  @db.Decimal(15, 2)
  fecha          DateTime @default(now())

  periodo     Periodo      @relation(fields: [periodoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@unique([periodoId])
  @@index([periodoId])
}

model Empleado {
  id                      String   @id @default(uuid())
  terceroId               String   @unique
  cargo                   String?
  salarioBase             Decimal  @db.Decimal(15, 2)
  fechaIngreso            DateTime @db.Date
  fechaRetiro             DateTime? @db.Date
  ibcAjuste               Decimal  @default(0) @db.Decimal(15, 2)
  arlEmpleador            Decimal  @default(0.522) @db.Decimal(5, 3)
  auxilioTransporteManual Boolean  @default(false)
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tercero       Tercero          @relation(fields: [terceroId], references: [id])
  liquidaciones Nomina[]
  provisiones   ProvisionNomina[]

  @@index([activo])
}

model Nomina {
  id                Int          @id @default(autoincrement())
  empleadoId        String
  periodoId         Int
  diasTrabajados    Int          @default(30)
  sueldo            Decimal      @default(0) @db.Decimal(15, 2)
  horasExtras       Decimal      @default(0) @db.Decimal(15, 2)
  comisiones        Decimal      @default(0) @db.Decimal(15, 2)
  bonificaciones    Decimal      @default(0) @db.Decimal(15, 2)
  auxilioTransporte Decimal      @default(0) @db.Decimal(15, 2)
  otrosDevengados   Decimal      @default(0) @db.Decimal(15, 2)
  saludEmpleado     Decimal      @default(0) @db.Decimal(15, 2)
  pensionEmpleado   Decimal      @default(0) @db.Decimal(15, 2)
  solidaridad       Decimal      @default(0) @db.Decimal(15, 2)
  retefuente        Decimal      @default(0) @db.Decimal(15, 2)
  libranzas         Decimal      @default(0) @db.Decimal(15, 2)
  embargos          Decimal      @default(0) @db.Decimal(15, 2)
  otrosDescuentos   Decimal      @default(0) @db.Decimal(15, 2)
  ibc               Decimal      @default(0) @db.Decimal(15, 2)
  aporteSalud       Decimal      @default(0) @db.Decimal(15, 2)
  aportePension     Decimal      @default(0) @db.Decimal(15, 2)
  aporteArl         Decimal      @default(0) @db.Decimal(15, 2)
  aporteCaja        Decimal      @default(0) @db.Decimal(15, 2)
  aporteIcbf        Decimal      @default(0) @db.Decimal(15, 2)
  aporteSena        Decimal      @default(0) @db.Decimal(15, 2)
  totalDevengado    Decimal      @db.Decimal(15, 2)
  totalDeducciones  Decimal      @db.Decimal(15, 2)
  netoPagar         Decimal      @db.Decimal(15, 2)
  estado            EstadoNomina @default(BORRADOR)
  comprobanteId     Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  empleado    Empleado     @relation(fields: [empleadoId], references: [id])
  periodo     Periodo      @relation(fields: [periodoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@unique([empleadoId, periodoId])
  @@index([periodoId, estado])
}

model ProvisionNomina {
  id                Int      @id @default(autoincrement())
  empleadoId        String
  periodoId         Int
  baseCesantias     Decimal  @db.Decimal(15, 2)
  cesantias         Decimal  @db.Decimal(15, 2)
  interesesCesantias Decimal @db.Decimal(15, 2)
  prima             Decimal  @db.Decimal(15, 2)
  baseVacaciones    Decimal  @db.Decimal(15, 2)
  vacaciones        Decimal  @db.Decimal(15, 2)
  total             Decimal  @db.Decimal(15, 2)
  comprobanteId     Int?
  createdAt         DateTime @default(now())

  empleado    Empleado     @relation(fields: [empleadoId], references: [id])
  periodo     Periodo      @relation(fields: [periodoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@unique([empleadoId, periodoId])
  @@index([periodoId])
}

model ParametroNomina {
  id                         Int      @id @default(autoincrement())
  empresaId                  String?
  anio                       Int
  smmlv                      Decimal  @db.Decimal(15, 2)
  auxilioTransporte          Decimal  @db.Decimal(15, 2)
  topeAuxilioTransporteSalarios Decimal @db.Decimal(5, 2)
  topeIbcSalarios            Decimal  @db.Decimal(5, 2)
  saludEmpleado              Decimal  @db.Decimal(5, 2)
  pensionEmpleado            Decimal  @db.Decimal(5, 2)
  saludEmpleador             Decimal  @db.Decimal(5, 2)
  pensionEmpleador           Decimal  @db.Decimal(5, 2)
  arlEmpleador               Decimal  @db.Decimal(5, 3)
  cajaCompensacion           Decimal  @db.Decimal(5, 2)
  icbf                       Decimal  @db.Decimal(5, 2)
  sena                       Decimal  @db.Decimal(5, 2)
  umbralParafiscales         Int
  solidaridadUmbralSalarios  Decimal  @db.Decimal(5, 2)
  interesesCesantias         Decimal  @db.Decimal(5, 2)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  empresa Empresa? @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, anio])
}

model ParametroCuentaNomina {
  id        Int      @id @default(autoincrement())
  empresaId String
  concepto  String
  cuentaId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])

  @@unique([empresaId, concepto])
  @@index([cuentaId])
}

model Presupuesto {
  id        Int      @id @default(autoincrement())
  cuentaId  Int
  periodoId Int
  valor     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])
  periodo Periodo @relation(fields: [periodoId], references: [id])

  @@unique([cuentaId, periodoId])
  @@index([periodoId])
}

model ReglaAlerta {
  id        Int        @id @default(autoincrement())
  tipo      TipoAlerta @unique
  dias      Int?
  activa    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Adjunto {
  id            Int                  @id @default(autoincrement())
  empresaId     String
  entidad       TipoAdjuntoEntidad
  entidadId     String
  nombreOriginal String
  nombreArchivo String
  mimeType      String
  tamanoBytes   Int
  hash          String
  usuarioId     String
  createdAt     DateTime             @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, entidad, entidadId])
}

model Conciliacion {
  id           Int                 @id @default(autoincrement())
  empresaId    String
  periodoId    Int
  cuentaId     Int
  estado       EstadoConciliacion  @default(EN_PROCESO)
  saldoLibros  Decimal             @default(0) @db.Decimal(15, 2)
  saldoExtracto Decimal            @default(0) @db.Decimal(15, 2)
  diferencia   Decimal             @default(0) @db.Decimal(15, 2)
  aprobadaPor  String?
  aprobadaEn   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  empresa    Empresa             @relation(fields: [empresaId], references: [id])
  periodo    Periodo             @relation(fields: [periodoId], references: [id])
  cuenta     Cuenta              @relation(fields: [cuentaId], references: [id])
  aprobador  Usuario?            @relation("ConciliacionAprobador", fields: [aprobadaPor], references: [id])
  movimientos MovimientoExtracto[]

  @@unique([empresaId, periodoId, cuentaId])
  @@index([empresaId, estado])
}

model MovimientoExtracto {
  id             Int      @id @default(autoincrement())
  conciliacionId Int
  fecha          DateTime @db.Date
  referencia     String
  descripcion    String
  debito         Decimal  @default(0) @db.Decimal(15, 2)
  credito        Decimal  @default(0) @db.Decimal(15, 2)
  saldo          Decimal  @default(0) @db.Decimal(15, 2)
  hashMovimiento String
  conciliado     Boolean  @default(false)
  asientoId      Int?

  conciliacion Conciliacion @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)
  asiento      Asiento?     @relation(fields: [asientoId], references: [id])

  @@unique([conciliacionId, hashMovimiento])
  @@index([conciliacionId])
}
