generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CONTADOR
  AUXILIAR
}

enum Naturaleza {
  DEUDORA
  ACREEDORA
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(AUXILIAR)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cuenta {
  id                Int        @id @default(autoincrement())
  codigo            String     @unique
  nombre            String
  nivel             Int
  clase             Int
  grupo             Int?
  cuenta            Int?
  subcuenta         Int?
  naturaleza        Naturaleza
  permiteMovimiento Boolean    @default(false)
  afectaResultado   Boolean    @default(false)
  requiereTercero   Boolean    @default(false)
  activa            Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([clase, grupo])
  @@index([nivel])
}

model Parametro {
  id               Int      @id @default(autoincrement())
  nombreEmpresa    String
  nit              String
  direccion        String?
  telefono         String?
  moneda           String   @default("COP")
  anioFiscalInicio Int      @default(1)
  mensajeRecibo    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
