# Copia este archivo a .env y completa los valores reales.
DATABASE_URL="postgresql://usuario:password@localhost:5432/contabilidad?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo"
PORT=3000

# Base de datos de tests (opcional). Si no se define, `npm test` deriva
# automáticamente la URL agregando "_test" al nombre de la base de DATABASE_URL
# (p. ej. contabilidad -> contabilidad_test). Nunca debe apuntar a la misma
# base de producción: la suite borra tablas durante su ejecución.
DATABASE_URL_TEST="postgresql://usuario:password@localhost:5432/contabilidad_test?schema=public"
