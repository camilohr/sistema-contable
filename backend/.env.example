# Copia este archivo a .env y completa los valores reales.
# JWT_SECRET: mínimo 32 caracteres (validado al arrancar).
DATABASE_URL="postgresql://usuario:password@localhost:5432/contabilidad?schema=public"
JWT_SECRET="cambia-esta-frase-por-un-secreto-largo-de-al-menos-32-caracteres"
PORT=3000

# Credencial inicial del admin (npm run db:seed). Si no se define, el seed genera
# una contraseña aleatoria y la imprime UNA sola vez en la consola. rounds >= 12.
#ADMIN_INITIAL_PASSWORD="cambiar-en-el-primer-ingreso"
#BCRYPT_ROUNDS=12

# Orígenes CORS permitidos separados por coma (por defecto solo localhost:3000 y
# 127.0.0.1:3000). Ej.: http://192.168.18.219:3000
#CORS_ORIGIN="http://192.168.18.219:3000"

# TLS opcional en la LAN (docs/despliegue.md). Sin estas variables se sirve HTTP.
#HTTPS_CERT="C:\ruta\a\local-cert.pem"
#HTTPS_KEY="C:\ruta\a\local-key.pem"

# Base de datos de tests (opcional). Si no se define, `npm test` deriva
# automáticamente la URL agregando "_test" al nombre de la base de DATABASE_URL
# (p. ej. contabilidad -> contabilidad_test). Nunca debe apuntar a la misma
# base de producción: la suite borra tablas durante su ejecución.
DATABASE_URL_TEST="postgresql://usuario:password@localhost:5432/contabilidad_test?schema=public"

# Copia externa opcional de respaldos (2.2). Si se define, `npm run backup`
# además de dejar el respaldo en backups/ copia el .dump y el adjuntos.zip a
# esta carpeta (p. ej. un disco USB). Si la ruta no está disponible, el backup
# local se crea igual y se registra la omisión en backups/backup.log.
#BACKUP_COPIA_EXTERNA_DIR="X:\respaldo-sistema-contable"

# Ruta del log de respaldos que usa la alerta de "respaldo desactualizado"
# (opcional; por defecto lee backups/backup.log del proyecto).
#BACKUP_LOG_PATH="C:\algo\backup.log"
